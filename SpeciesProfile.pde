class SpeciesProfile {
  int fiducialId;
  String sound1File;
  String sound2File;
  int foodIndex;

  SpeciesProfile(int fiducialId, String sound1File, String sound2File, int foodIndex) {
    this.fiducialId = fiducialId;
    this.sound1File = sound1File;
    this.sound2File = sound2File;
    this.foodIndex = foodIndex;
  }
}
